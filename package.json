  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@googleapis/drive": "^21.0.0",
    "@googleapis/gmail": "^18.0.0",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5"
  }
}
